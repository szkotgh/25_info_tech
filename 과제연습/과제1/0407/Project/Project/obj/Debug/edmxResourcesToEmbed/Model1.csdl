<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="DatarailModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="location">
    <Key>
      <PropertyRef Name="lno" />
    </Key>
    <Property Name="lno" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="lname" Type="String" MaxLength="10" FixedLength="false" Unicode="true" />
    <Property Name="lx" Type="Int32" />
    <Property Name="ly" Type="Int32" />
    <NavigationProperty Name="schedule" Relationship="Self.FK_schedule_location" FromRole="location" ToRole="schedule" />
  </EntityType>
  <EntityType Name="reservation">
    <Key>
      <PropertyRef Name="rno" />
    </Key>
    <Property Name="rno" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="uno" Type="Int32" />
    <Property Name="sno" Type="Int32" />
    <Property Name="carno" Type="Int32" />
    <Property Name="seat" Type="String" MaxLength="50" FixedLength="false" Unicode="true" />
  </EntityType>
  <EntityType Name="schedule">
    <Key>
      <PropertyRef Name="sno" />
    </Key>
    <Property Name="sno" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="date" Type="DateTime" Precision="0" />
    <Property Name="starting" Type="Int32" />
    <Property Name="destination" Type="Int32" />
    <Property Name="time" Type="Time" Precision="7" />
    <NavigationProperty Name="location" Relationship="Self.FK_schedule_location" FromRole="schedule" ToRole="location" />
  </EntityType>
  <EntityType Name="user">
    <Key>
      <PropertyRef Name="uno" />
    </Key>
    <Property Name="uno" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="id" Type="String" MaxLength="10" FixedLength="false" Unicode="true" />
    <Property Name="pw" Type="String" MaxLength="20" FixedLength="false" Unicode="true" />
    <Property Name="name" Type="String" MaxLength="10" FixedLength="false" Unicode="true" />
    <Property Name="birth" Type="DateTime" Precision="0" />
    <Property Name="phone" Type="String" MaxLength="15" FixedLength="false" Unicode="true" />
    <Property Name="email" Type="String" MaxLength="30" FixedLength="false" Unicode="true" />
  </EntityType>
  <Association Name="FK_schedule_location">
    <End Role="location" Type="Self.location" Multiplicity="0..1" />
    <End Role="schedule" Type="Self.schedule" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="location">
        <PropertyRef Name="lno" />
      </Principal>
      <Dependent Role="schedule">
        <PropertyRef Name="starting" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="DatarailEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="location" EntityType="Self.location" />
    <EntitySet Name="reservation" EntityType="Self.reservation" />
    <EntitySet Name="schedule" EntityType="Self.schedule" />
    <EntitySet Name="user" EntityType="Self.user" />
    <AssociationSet Name="FK_schedule_location" Association="Self.FK_schedule_location">
      <End Role="location" EntitySet="location" />
      <End Role="schedule" EntitySet="schedule" />
    </AssociationSet>
  </EntityContainer>
</Schema>